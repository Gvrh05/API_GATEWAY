PORT=3004
# Debe coincidir con el secret de las credenciales jwt en kong/kong.yml
JWT_SECRET=change-me-super-secret-for-demo-min-32-chars!!
JWT_EXPIRES_IN=1h
# Formato usuario:password:rol separados por coma
AUTH_USERS=admin:admin123:admin,user:user123:user
# iss (key) de cada consumer JWT declarado en kong.yml
JWT_ISS_ADMIN=admin-issuer
JWT_ISS_USER=user-issuer
# URLs para el health agregado
PRODUCT_SERVICE_URL=http://product-service:3001
ORDER_SERVICE_URL=http://order-service:3002
CUSTOMER_SERVICE_URL=http://customer-service:3003
